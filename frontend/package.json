{
  "name": "@connectsphere/frontend",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:4000",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint --max-warnings 0 src",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.js"
        ],
        "excludedFiles": [
          "**/*Api.js",
          "**/*ApiSupport.js",
          "**/*.test.js",
          "src/lib/firebase.js",
          "src/app/App.js",
          "src/app/Workspace.js",
          "src/sandbox/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "firebase/*"
                  ],
                  "message": "Screens reach data through their feature's *Api.js module (docs/adr/0002-frontend-data-access.md)."
                }
              ]
            }
          ],
          "no-restricted-globals": [
            "error",
            {
              "name": "fetch",
              "message": "Screens reach data through their feature's *Api.js module (docs/adr/0002-frontend-data-access.md)."
            }
          ]
        }
      },
      {
        "files": [
          "**/*.test.js",
          "**/*.test.jsx",
          "**/*.spec.js",
          "**/*.spec.jsx"
        ],
        "env": {
          "jest": true
        },
        "rules": {
          "import/first": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "ConnectSphere web client (Create React App)."
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && profile().role == role; }
    function ownsEvent(eventId) { return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.organiser_id == request.auth.uid; }
    function currentCoordinator(eventId) { return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.coordinator_id == request.auth.uid; }
    function previousCoordinator(eventId) { return signedIn() && exists(/databases/$(database)/documents/coordinator_assignments/$(eventId + '_' + request.auth.uid)); }
    function canReadEvent(eventId) { return ownsEvent(eventId) || currentCoordinator(eventId) || previousCoordinator(eventId); }
    // A7 — a Safety Officer is related to an event only while it awaits its
    // Operational Safety Check (L1). Once the check is recorded the event leaves
    // Safety Review and drops out of their reach again.
    function safetyReviewing(eventId) { return hasRole('SAFETY_OFFICER') && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'SAFETY_REVIEW'; }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role in ['EVENT_ORGANISER', 'ATTENDEE']
        && request.resource.data.mobile_number is string
        && request.resource.data.mobile_number.matches('^[0-9]{7,15}$');
      // C8/C9 need the assigned coordinator's name and the active coordinator
      // directory. Only active coordinator profiles are exposed to other signed-
      // in users; list access remains coordinator-only and therefore requires a
      // role/is_active constrained query.
      allow get: if signedIn() && (userId == request.auth.uid
        || (resource.data.role == 'EVENT_COORDINATOR' && resource.data.is_active == true));
      allow list: if hasRole('EVENT_COORDINATOR')
        && resource.data.role == 'EVENT_COORDINATOR'
        && resource.data.is_active == true;
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.mobile_number is string
        && request.resource.data.mobile_number.matches('^[0-9]{7,15}$');
    }

    match /events/{eventId} {
      // A5 is one clause per role, each naming the field on the event that
      // relates that role to it — the same fields the client filters on in
      // domain/roles.js (EVENT_SCOPE_FIELD). Chosen over a single
      // related_user_ids array because no denormalised field has to be kept in
      // step; the cost is a new clause whenever a role is added.
      //
      // get() with a default keeps a missing field from erroring the whole
      // expression: an event created today has only organiser_id.
      // C1 assigns the initial coordinator through the existing backend. A
      // browser may create an event with no coordinator, and organiser edits
      // must preserve these fields. The narrow C9 coordinator workflow below
      // is the only browser-side exception.
      function noClientCoordinatorWrite() {
        return request.resource.data.get('coordinator_id', null) == null
          && request.resource.data.get('assigned_at', null) == null;
      }
      function coordinatorUnchanged() {
        return request.resource.data.get('coordinator_id', null) == resource.data.get('coordinator_id', null)
          && request.resource.data.get('assigned_at', null) == resource.data.get('assigned_at', null);
      }
      function coordinatorWorkflowUpdate() {
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && (
            (resource.data.status == 'SUBMITTED'
              && request.resource.data.status == 'UNDER_REVIEW'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
            || (resource.data.status == 'UNDER_REVIEW'
              && resource.data.get('open_clarification_id', null) == null
              && request.resource.data.open_clarification_id is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open_clarification_id', 'updated_at']))
            || (resource.data.status == 'UNDER_REVIEW'
              && resource.data.get('open_clarification_id', null) == null
              && request.resource.data.status == 'REJECTED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
            || (!(resource.data.status in ['COMPLETED', 'CANCELLED', 'REJECTED'])
              && request.resource.data.coordinator_id != request.auth.uid
              && get(/databases/$(database)/documents/users/$(request.resource.data.coordinator_id)).data.role == 'EVENT_COORDINATOR'
              && get(/databases/$(database)/documents/users/$(request.resource.data.coordinator_id)).data.is_active == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coordinator_id', 'assigned_at', 'updated_at']))
          );
      }
      // C7 AC3 — terminal requests are not editable through a crafted client
      // call. Drafts may be saved/submitted; Under Review is writable only for
      // the narrow C5 clarification-amendment window, without changing the
      // workflow marker itself, except when the organiser's response transaction
      // closes that marker atomically.
      function organiserMayEdit() {
        return resource.data.status == 'DRAFT'
          || (resource.data.status == 'UNDER_REVIEW'
            && resource.data.get('open_clarification_id', null) != null
            && request.resource.data.status == 'UNDER_REVIEW'
            && (request.resource.data.get('open_clarification_id', null) == resource.data.get('open_clarification_id', null)
              || (request.resource.data.get('open_clarification_id', null) == null
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open_clarification_id', 'updated_at']))));
      }

      // A7 AC4 / L3 — the Safety Officer's only write to an event is the outcome
      // of its check: Confirmed on approval, back to Planning on reject or
      // request changes. The event must point at the safety_reviews record
      // written in the same batch, and that record's outcome must match the
      // move, so no event reaches Confirmed without an approved check (L1 AC4).
      function safetyOutcomeUpdate() {
        let review = getAfter(/databases/$(database)/documents/safety_reviews/$(request.resource.data.last_safety_review_id)).data;
        return hasRole('SAFETY_OFFICER')
          && resource.data.status == 'SAFETY_REVIEW'
          && request.resource.data.last_safety_review_id is string
          && review.event_id == eventId
          && review.reviewer_id == request.auth.uid
          && ((review.outcome == 'APPROVE' && request.resource.data.status == 'CONFIRMED')
            || (review.outcome in ['REJECT', 'REQUEST_CHANGES'] && request.resource.data.status == 'PLANNING'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'last_safety_review_id', 'updated_at']);
      }

      allow create: if hasRole('EVENT_ORGANISER') && request.resource.data.organiser_id == request.auth.uid && request.resource.data.created_by == request.auth.uid && noClientCoordinatorWrite();
      allow get, list: if (hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid)
        || (hasRole('EVENT_COORDINATOR') && resource.data.get('coordinator_id', '') == request.auth.uid)
        || (hasRole('EVENT_COORDINATOR') && previousCoordinator(eventId))
        || (hasRole('VENUE_STAFF') && resource.data.get('venue_staff_id', '') == request.auth.uid)
        || (hasRole('TECHNICAL_SUPPORT_STAFF') && resource.data.get('tech_support_id', '') == request.auth.uid)
        // A7 AC2 — a list query must filter on status == 'SAFETY_REVIEW'.
        || (hasRole('SAFETY_OFFICER') && resource.data.status == 'SAFETY_REVIEW');
      allow update: if (hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid && coordinatorUnchanged() && organiserMayEdit())
        || coordinatorWorkflowUpdate()
        || safetyOutcomeUpdate();
      // B8 — only the owning organiser, and only while it is still a draft. Once a
      // request has been submitted it is part of a coordinator's queue, so it is
      // no longer the organiser's alone to remove.
      allow delete: if hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid && resource.data.status == 'DRAFT';
    }

    // A7 AC3 — the Safety Officer reads the layout, accessibility and equipment
    // facts of an event under review, never writes them.
    match /event_venue_requirements/{requirementId} {
      allow create: if ownsEvent(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
      allow update, delete: if ownsEvent(resource.data.event_id);
    }
    match /event_facilities/{facilityId} {
      allow create: if ownsEvent(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id);
      allow update, delete: if ownsEvent(resource.data.event_id);
    }
    match /event_equipment/{equipmentId} {
      allow create: if ownsEvent(request.resource.data.event_id);
      allow get, list: if ownsEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
      allow update, delete: if ownsEvent(resource.data.event_id);
    }
    match /event_accessibility/{accessibilityId} {
      allow create: if ownsEvent(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
      allow update, delete: if ownsEvent(resource.data.event_id);
    }
    match /event_history/{historyId} {
      allow create: if signedIn()
        && request.resource.data.get('history_id', historyId) == historyId
        && request.resource.data.actor_id == request.auth.uid
        && (ownsEvent(request.resource.data.event_id) || currentCoordinator(request.resource.data.event_id)
          || safetyReviewing(request.resource.data.event_id));
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
    }

    match /clarification_requests/{clarificationId} {
      allow get, list: if canReadEvent(resource.data.event_id);
      allow create: if hasRole('EVENT_COORDINATOR')
        && request.resource.data.clarification_id == clarificationId
        && request.resource.data.created_by == request.auth.uid
        && currentCoordinator(request.resource.data.event_id)
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.status == 'UNDER_REVIEW'
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('open_clarification_id', null) == null;
      allow update: if hasRole('EVENT_ORGANISER')
        && ownsEvent(resource.data.event_id)
        && resource.data.status == 'OPEN'
        && request.resource.data.status == 'ANSWERED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at']);
    }

    match /clarification_responses/{responseId} {
      function clarification() { return get(/databases/$(database)/documents/clarification_requests/$(request.resource.data.clarification_id)).data; }
      function existingClarification() { return get(/databases/$(database)/documents/clarification_requests/$(resource.data.clarification_id)).data; }
      allow get, list: if canReadEvent(existingClarification().event_id);
      allow create: if hasRole('EVENT_ORGANISER')
        && request.resource.data.response_id == responseId
        && request.resource.data.responder_id == request.auth.uid
        && ownsEvent(clarification().event_id)
        && clarification().status == 'OPEN';
    }

    // A7 AC4 / L3 — one record per check. Reject and Request changes need a
    // comment. No update or delete: a recorded outcome is history (L2 AC4 shows
    // earlier ones), and a fresh check after a return to Planning is a new record.
    match /safety_reviews/{reviewId} {
      allow get, list: if hasRole('SAFETY_OFFICER') || canReadEvent(resource.data.event_id);
      allow create: if safetyReviewing(request.resource.data.event_id)
        && request.resource.data.review_id == reviewId
        && request.resource.data.reviewer_id == request.auth.uid
        && request.resource.data.outcome in ['APPROVE', 'REJECT', 'REQUEST_CHANGES']
        && (request.resource.data.outcome == 'APPROVE'
          || (request.resource.data.comment is string && request.resource.data.comment.size() > 0))
        && request.resource.data.decided_at is timestamp;
    }

    match /coordinator_assignments/{assignmentId} {
      allow get, list: if signedIn()
        && (resource.data.coordinator_id == request.auth.uid || canReadEvent(resource.data.event_id));
      allow create, update: if hasRole('EVENT_COORDINATOR')
        && currentCoordinator(request.resource.data.event_id)
        && assignmentId == request.resource.data.event_id + '_' + request.resource.data.coordinator_id;
    }

    match /notifications/{notificationId} {
      // J1 AC2 — a user reads only notifications addressed to them. AC3/AC4 — the
      // one change they may make is marking one read: it cannot be re-addressed,
      // reworded or marked unread, and with no delete rule it stays in the list.
      allow get, list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.is_read == true
        && request.resource.data.read_at is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'read_at']);
      allow create: if signedIn()
        && request.resource.data.notification_id == notificationId
        && (
          (currentCoordinator(request.resource.data.event_id)
            && request.resource.data.user_id in [request.auth.uid,
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organiser_id,
              getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id])
          || (ownsEvent(request.resource.data.event_id)
            && request.resource.data.user_id == get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id)
          // L3 AC4 / L4 AC1 — the outcome goes to the event's coordinator and organiser.
          || (safetyReviewing(request.resource.data.event_id)
            && request.resource.data.user_id in [
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organiser_id,
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id])
        );
    }

    // E2 / E5 — catalogue and search reads are Coordinator and Venue Staff only.
    // Hiding the screen is not the boundary (A4 / TC-015). A7 AC3 / E10 AC3 add
    // the Safety Officer, read-only, to venues, layouts and accessibility for
    // capacity, layout, emergency access and known restrictions.
    match /venue_staff/{venueId} {
      allow get, list: if hasRole('VENUE_STAFF')
        && resource.data.user_id == request.auth.uid;
    }
    match /venues/{venueId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
      allow update: if hasRole('VENUE_STAFF')
        && exists(/databases/$(database)/documents/venue_staff/$(venueId))
        && get(/databases/$(database)/documents/venue_staff/$(venueId)).data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'building', 'location', 'max_capacity', 'layouts', 'facilities',
          'accessibility', 'operating_hours', 'special_space_availability'
        ])
        && request.resource.data.name is string
        && request.resource.data.building is string
        && request.resource.data.location is string
        && request.resource.data.max_capacity is int
        && request.resource.data.max_capacity > 0
        && request.resource.data.layouts is list
        && request.resource.data.layouts.size() > 0
        && request.resource.data.facilities is list
        && request.resource.data.accessibility is list
        && request.resource.data.operating_hours is list
        && request.resource.data.special_space_availability is string;
    }
    match /venue_layouts/{layoutId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
    }
    match /venue_facilities/{facilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_accessibility/{accessibilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
    }
    match /venue_operating_hours/{hoursId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_unavailability/{unavailabilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_bookings/{bookingId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF')
        || safetyReviewing(resource.data.event_id);
      // E8 — the suitability gate, enforced where it cannot be bypassed. A screen
      // that merely disables its button does not stop a crafted request, so the
      // capacity stop is re-checked against the venue record here, and a booking
      // is refused unless it carries the acknowledgement Venue Staff will read.
      // There is deliberately no update rule: an acknowledgement is a record of
      // what the coordinator accepted at the time and is not rewritten later.
      allow create: if hasRole('EVENT_COORDINATOR')
        && request.resource.data.requested_by == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.venue_id is string
        && request.resource.data.event_id is string
        && request.resource.data.expected_attendance is int
        && request.resource.data.expected_attendance > 0
        && exists(/databases/$(database)/documents/venues/$(request.resource.data.venue_id))
        && get(/databases/$(database)/documents/venues/$(request.resource.data.venue_id)).data.max_capacity >= request.resource.data.expected_attendance
        && request.resource.data.suitability_acknowledgement.acknowledged is bool
        && request.resource.data.suitability_acknowledgement.criteria is list;
      // Withdrawing is the one change the raiser may make, and it may only ever
      // move a pending request to withdrawn. The acknowledgement is pinned: it
      // records what was accepted at the time and is never rewritten.
      allow update: if hasRole('EVENT_COORDINATOR')
        && resource.data.requested_by == request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'WITHDRAWN'
        && request.resource.data.suitability_acknowledgement == resource.data.suitability_acknowledgement
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawn_at']);
    }
  }
}

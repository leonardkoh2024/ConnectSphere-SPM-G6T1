rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && profile().role == role; }
    function ownsEvent(eventId) { return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.organiser_id == request.auth.uid; }
    function currentCoordinator(eventId) { return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.coordinator_id == request.auth.uid; }
    // K5 / SCRUM-186 — an event and the records hanging off it are readable by its
    // organiser and its CURRENT coordinator only. The previous-coordinator route that
    // stood here (C9) is removed: a coordinator reassigned away loses all access.
    function canReadEvent(eventId) { return ownsEvent(eventId) || currentCoordinator(eventId); }
    function significantChangeHistory(eventId) {
      let changedEvent = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      let historyId = changedEvent.get('last_significant_change_id', '');
      let change = getAfter(/databases/$(database)/documents/event_history/$(historyId)).data;
      return hasRole('EVENT_COORDINATOR')
        && changedEvent.coordinator_id == request.auth.uid
        && changedEvent.status in ['APPROVED', 'PLANNING', 'CONFIRMED']
        && historyId is string
        && change.event_id == eventId
        && change.actor_id == request.auth.uid
        && change.action_type == 'SIGNIFICANT_EVENT_DETAILS_CHANGED'
        && change.warning_acknowledged == true
        // Written in this same commit, so an old acknowledgement cannot cover a later write.
        && change.created_at == request.time;
    }
    function assignedVenueStaff(venueId) {
      return hasRole('VENUE_STAFF')
        && exists(/databases/$(database)/documents/venue_staff/$(venueId))
        && get(/databases/$(database)/documents/venue_staff/$(venueId)).data.user_id == request.auth.uid;
    }
    // F15 — a hold lasts exactly three working days (Mon–Fri, Singapore time),
    // the same count domain/venueHolds.js makes. Whole days since 1 Jan 1970 (a
    // Thursday) in Singapore time, UTC+8, give the weekday: 0 Thu, 1 Fri, 2 Sat,
    // 3 Sun, 4 Mon, 5 Tue, 6 Wed. From Sun, Mon or Tue the expiry is 3 days on;
    // from Sat, 4; from Wed, Thu or Fri, 5. The device placing the hold computes
    // it from its own clock, so five minutes either side of this count is allowed.
    function holdExpiryIsThreeWorkingDays(expiresAt) {
      let weekday = math.floor((request.time.toMillis() + 28800000) / 86400000) % 7;
      let days = weekday in [0, 1, 6] ? 5 : (weekday == 2 ? 4 : 3);
      return expiresAt is timestamp
        && math.abs(expiresAt.toMillis() - (request.time.toMillis() + days * 86400000)) <= 300000;
    }
    // A7 — a Safety Officer is related to an event only while it awaits its
    // Operational Safety Check (L1). Once the check is recorded the event leaves
    // Safety Review and drops out of their reach again.
    function safetyReviewing(eventId) { return hasRole('SAFETY_OFFICER') && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'SAFETY_REVIEW'; }
    // A7 AC4 — a write the Safety Officer makes only alongside an outcome: in the
    // same commit the event leaves Safety Review, pointing at a review recorded
    // at this request's time. Their history entries and notices must pass this,
    // so none can be sent on its own.
    function safetyOutcomeCommit(eventId) {
      let after = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return safetyReviewing(eventId)
        && after.status in ['CONFIRMED', 'PLANNING']
        && after.get('last_safety_review_id', '') is string
        && after.get('last_safety_review_id', '').size() > 0
        && getAfter(/databases/$(database)/documents/safety_reviews/$(after.last_safety_review_id)).data.decided_at == request.time;
    }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role in ['EVENT_ORGANISER', 'ATTENDEE']
        && request.resource.data.mobile_number is string
        && request.resource.data.mobile_number.matches('^[0-9]{7,15}$');
      // C8/C9 need the assigned coordinator's name and the active coordinator
      // directory. Only active coordinator profiles are exposed to other signed-
      // in users; list access remains coordinator-only and therefore requires a
      // role/is_active constrained query.
      // A6 — the Lead reads any profile so its board can name each event's
      // organiser and coordinator; others still see only themselves and active
      // coordinators.

      // C2 AC2 — a coordinator reads organiser profiles, so their event lists
      // and event details can name each event's organiser. Attendee and other
      // staff profiles stay closed to them.

      allow get: if signedIn() && (userId == request.auth.uid
        || hasRole('EVENT_COORDINATOR_LEAD')
        || (hasRole('EVENT_COORDINATOR') && resource.data.role == 'EVENT_ORGANISER')
        || (resource.data.role == 'EVENT_COORDINATOR' && resource.data.is_active == true));
      allow list: if ((hasRole('EVENT_COORDINATOR') || hasRole('EVENT_COORDINATOR_LEAD'))
          && resource.data.role == 'EVENT_COORDINATOR'
          && resource.data.is_active == true)
        || (hasRole('EVENT_COORDINATOR')
          && resource.data.role == 'SAFETY_OFFICER'
          && resource.data.is_active == true);
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.mobile_number is string
        && request.resource.data.mobile_number.matches('^[0-9]{7,15}$');
    }

    match /events/{eventId} {
      // A5 is one clause per role, each naming the field on the event that
      // relates that role to it — the same fields the client filters on in
      // domain/roles.js (EVENT_SCOPE_FIELD). Chosen over a single
      // related_user_ids array because no denormalised field has to be kept in
      // step; the cost is a new clause whenever a role is added.
      //
      // get() with a default keeps a missing field from erroring the whole
      // expression: an event created today has only organiser_id.
      // C1 assigns the initial coordinator through the existing backend. A
      // browser may create an event with no coordinator, and organiser edits
      // must preserve these fields. The narrow C9 coordinator workflow below
      // is the only browser-side exception.
      function noClientCoordinatorWrite() {
        return request.resource.data.get('coordinator_id', null) == null
          && request.resource.data.get('assigned_at', null) == null;
      }
      function coordinatorUnchanged() {
        return request.resource.data.get('coordinator_id', null) == resource.data.get('coordinator_id', null)
          && request.resource.data.get('assigned_at', null) == resource.data.get('assigned_at', null);
      }
      function coordinatorWorkflowUpdate() {
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && (
            (resource.data.status in ['SUBMITTED', 'UNDER_REVIEW', 'APPROVED', 'PLANNING', 'SAFETY_REVIEW', 'CONFIRMED']
              && request.resource.data.status == 'CANCELLED'
              && request.resource.data.cancellation_reason is string
              && request.resource.data.cancellation_reason.size() > 0
              && request.resource.data.cancelled_at == request.time
              && request.resource.data.updated_at == request.time
              && request.resource.data.last_cancellation_id is string
              && getAfter(/databases/$(database)/documents/event_history/$(request.resource.data.last_cancellation_id)).data.event_id == eventId
              && getAfter(/databases/$(database)/documents/event_history/$(request.resource.data.last_cancellation_id)).data.actor_id == request.auth.uid
              && getAfter(/databases/$(database)/documents/event_history/$(request.resource.data.last_cancellation_id)).data.action_type == 'EVENT_CANCELLED'
              && getAfter(/databases/$(database)/documents/event_history/$(request.resource.data.last_cancellation_id)).data.created_at == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'cancellation_reason', 'cancelled_at', 'last_cancellation_id', 'updated_at'
              ]))
            ||
            (resource.data.status == 'SUBMITTED'
              && request.resource.data.status == 'UNDER_REVIEW'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
            || (resource.data.status == 'UNDER_REVIEW'
              && resource.data.get('open_clarification_id', null) == null
              && request.resource.data.open_clarification_id is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open_clarification_id', 'updated_at']))
            || (resource.data.status == 'UNDER_REVIEW'
              && resource.data.get('open_clarification_id', null) == null
              && request.resource.data.status == 'REJECTED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
            // C6 / SCRUM-107 — approve: Under Review -> Approved, same guard as reject
            // (assigned coordinator, no open clarification), status and updated_at only.
            || (resource.data.status == 'UNDER_REVIEW'
              && resource.data.get('open_clarification_id', null) == null
              && request.resource.data.status == 'APPROVED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
            // K3 / SCRUM-184 — the coordinator-side reassignment clause that stood here
            // (C9 criterion 5) is removed: only the Event Coordinator Lead reassigns, via
            // leadAssignmentUpdate below.
          );
      }

      // A6 / Week 7 change #5 — the Event Coordinator Lead assigns and reassigns.
      // One clause covers both: the only coordinator change the Lead may make is
      // to a DIFFERENT active coordinator on a non-terminal event, touching only
      // the coordinator fields. New coordinator != old covers "assign" (old
      // absent) and "reassign" (old set) alike, and refuses handing an event back
      // to the coordinator who already holds it. The client guards
      // (canAssignCoordinator / canLeadReassign) mirror this; this is the boundary.
      function leadAssignmentUpdate() {
        return hasRole('EVENT_COORDINATOR_LEAD')
          && !(resource.data.status in ['COMPLETED', 'CANCELLED', 'REJECTED'])
          && request.resource.data.coordinator_id is string
          && request.resource.data.coordinator_id != resource.data.get('coordinator_id', null)
          && get(/databases/$(database)/documents/users/$(request.resource.data.coordinator_id)).data.role == 'EVENT_COORDINATOR'
          && get(/databases/$(database)/documents/users/$(request.resource.data.coordinator_id)).data.is_active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coordinator_id', 'assigned_at', 'updated_at']);
      }

      // D1 / SCRUM-111 and D2 / SCRUM-112 — the coordinator's Edit event save. One
      // clause, because one save may carry both kinds of change. Only the current
      // coordinator, only in Approved, Planning or Confirmed (D1 AC3), and only
      // the ordinary and significant fields, so no booking or reservation moves
      // and status and coordinator stay put (D1 AC1). Each kind of change must be
      // committed with its own history:
      //   ordinary (name, purpose, description, contact, internal notes) — the
      //     event points at an EVENT_DETAILS_UPDATED row by this actor, written
      //     now (D1 AC2);
      //   significant (pax, date, times) — the event points at an acknowledged
      //     SIGNIFICANT_EVENT_DETAILS_CHANGED row written now (D2), and the new
      //     values are well formed. Requirement, facility and accessibility rows
      //     are checked against that same row in their own collections.
      function ordinaryText(field, max) {
        return !(field in request.resource.data)
          || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
      }
      function ordinaryDetailsRecorded() {
        let change = getAfter(/databases/$(database)/documents/event_history/$(request.resource.data.last_detail_change_id)).data;
        return request.resource.data.last_detail_change_id is string
          && change.event_id == eventId
          && change.actor_id == request.auth.uid
          && change.action_type == 'EVENT_DETAILS_UPDATED'
          && change.created_at == request.time
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() > 0
          && ordinaryText('name', 200)
          && ordinaryText('purpose', 2000)
          && ordinaryText('description', 5000)
          && ordinaryText('contact_name', 200)
          && ordinaryText('contact_email', 254)
          && ordinaryText('contact_phone', 40)
          && ordinaryText('internal_notes', 5000);
      }
      function significantDetailsRecorded() {
        return significantChangeHistory(eventId)
          && request.resource.data.expected_attendance is int
          && request.resource.data.expected_attendance > 0
          && request.resource.data.event_date is string
          && request.resource.data.event_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.start_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.end_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      function coordinatorEventDetailsUpdate() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return hasRole('EVENT_COORDINATOR')
          && resource.data.get('coordinator_id', '') == request.auth.uid
          && resource.data.status in ['APPROVED', 'PLANNING', 'CONFIRMED']
          && request.resource.data.status == resource.data.status
          && request.resource.data.updated_at == request.time
          && keys.hasOnly([
            'name', 'purpose', 'description', 'contact_name', 'contact_email',
            'contact_phone', 'internal_notes', 'last_detail_change_id',
            'expected_attendance', 'event_date', 'start_time', 'end_time',
            'last_significant_change_id', 'updated_at'
          ])
          && keys.hasAny(['last_detail_change_id', 'last_significant_change_id'])
          // An ordinary field moves only with a fresh ordinary history row.
          && (!keys.hasAny(['name', 'purpose', 'description', 'contact_name', 'contact_email', 'contact_phone', 'internal_notes'])
            || keys.hasAny(['last_detail_change_id']))
          && (!keys.hasAny(['last_detail_change_id']) || ordinaryDetailsRecorded())
          // A significant field moves only with a fresh acknowledged row.
          && (!keys.hasAny(['expected_attendance', 'event_date', 'start_time', 'end_time'])
            || keys.hasAny(['last_significant_change_id']))
          && (!keys.hasAny(['last_significant_change_id']) || significantDetailsRecorded());
      }
      // C7 AC3 — terminal requests are not editable through a crafted client
      // call. Drafts may be saved/submitted; Under Review is writable only for
      // the narrow C5 clarification-amendment window, without changing the
      // workflow marker itself, except when the organiser's response transaction
      // closes that marker atomically.
      function organiserMayEdit() {
        return resource.data.status == 'DRAFT'
          || (resource.data.status == 'UNDER_REVIEW'
            && resource.data.get('open_clarification_id', null) != null
            && request.resource.data.status == 'UNDER_REVIEW'
            && (request.resource.data.get('open_clarification_id', null) == resource.data.get('open_clarification_id', null)
              || (request.resource.data.get('open_clarification_id', null) == null
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open_clarification_id', 'updated_at']))));
      }

      // A7 AC4 / L3 — the Safety Officer's only write to an event is the outcome
      // of its check: Confirmed on approval, back to Planning on reject or
      // request changes. The event must point at the safety_reviews record
      // written in the same batch, and that record's outcome must match the
      // move, so no event reaches Confirmed without an approved check (L1 AC4).
      // A7 — the review must be the one written in this commit (decided now), so
      // an earlier record can never confirm a later check.
      // L1 / SCRUM-187 — the assigned coordinator sends the event for its check.
      // The outstanding-arrangement gate is decided in the client from the
      // event's bookings; this clause is the status move itself.
      function sendForSafetyCheckUpdate() {
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && resource.data.status in ['APPROVED', 'PLANNING']
          && request.resource.data.status == 'SAFETY_REVIEW'
          && request.resource.data.safety_review_requested_at == request.time
          && request.resource.data.updated_at == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'safety_review_requested_at', 'updated_at']);
      }

      function safetyOutcomeUpdate() {
        let review = getAfter(/databases/$(database)/documents/safety_reviews/$(request.resource.data.last_safety_review_id)).data;
        let approvedBookingId = request.resource.data.get('approved_venue_booking_id', '');
        return hasRole('SAFETY_OFFICER')
          && resource.data.status == 'SAFETY_REVIEW'
          && request.resource.data.last_safety_review_id is string
          && review.event_id == eventId
          && review.reviewer_id == request.auth.uid
          && review.decided_at == request.time
          && ((review.outcome == 'APPROVE'
              && request.resource.data.status == 'CONFIRMED'
              && approvedBookingId is string
              && approvedBookingId.size() > 0
              && approvedVenueBookingFor(approvedBookingId))
            || (review.outcome in ['REJECT', 'REQUEST_CHANGES'] && request.resource.data.status == 'PLANNING'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'last_safety_review_id', 'updated_at', 'returned_to_planning_at', 'technical_review_status']);
      }

      // Called only on Approve, after the id is known to be present, so a Reject
      // on an event with no approved booking never looks one up.
      function approvedVenueBookingFor(bookingId) {
        let approvedBooking = getAfter(/databases/$(database)/documents/venue_bookings/$(bookingId)).data;
        return approvedBooking.event_id == eventId && approvedBooking.status == 'APPROVED';
      }

      // A7 AC3 — the coordinator records where equipment goes and how the crowd
      // moves, for the Safety Officer to read. Only those two notes, only on
      // their own event, and only while it is Approved or in Planning.
      function coordinatorSafetyNotesUpdate() {
        return hasRole('EVENT_COORDINATOR')
          && resource.data.get('coordinator_id', '') == request.auth.uid
          && resource.data.status in ['APPROVED', 'PLANNING']
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('equipment_placement', '') is string
          && request.resource.data.get('crowd_movement', '') is string
          && request.resource.data.get('equipment_placement', '').size() <= 2000
          && request.resource.data.get('crowd_movement', '').size() <= 2000
          && request.resource.data.updated_at == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipment_placement', 'crowd_movement', 'updated_at']);
      }

      // F4/F7 — Venue Staff may only link the event to the booking they approve
      // in the same atomic transaction. No event workflow field may be changed.
      function venueBookingApprovalLinkUpdate() {
        let bookingId = request.resource.data.get('approved_venue_booking_id', '');
        let booking = getAfter(/databases/$(database)/documents/venue_bookings/$(bookingId)).data;
        return bookingId is string
          && bookingId.size() > 0
          && booking.event_id == eventId
          && booking.status == 'APPROVED'
          && booking.decided_by == request.auth.uid
          && assignedVenueStaff(booking.venue_id)
          && request.resource.data.status == resource.data.status
          && request.resource.data.updated_at is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved_venue_booking_id', 'updated_at']);
      }

      // F8 cleanup after D4 has already committed cancellation. This narrowly
      // clears the released booking link and cannot change status or event data.
      function coordinatorVenueReleaseLinkUpdate() {
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && resource.data.status == 'CANCELLED'
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.get('approved_venue_booking_id', null) == null
          && request.resource.data.updated_at is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved_venue_booking_id', 'updated_at']);
      }

      // F14: one approved booking is released in the same transaction and is
      // named by an immutable history row. Confirmed returns to Planning and
      // loses its prior safety decision; other event data cannot move.
      function coordinatorSingleVenueReleaseUpdate() {
        let historyId = request.resource.data.get('last_venue_release_id', '');
        let history = getAfter(/databases/$(database)/documents/event_history/$(historyId)).data;
        let booking = getAfter(/databases/$(database)/documents/venue_bookings/$(history.booking_id)).data;
        let approvedId = request.resource.data.get('approved_venue_booking_id', null);
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && resource.data.status in ['APPROVED', 'PLANNING', 'CONFIRMED', 'SAFETY_REVIEW']
          && historyId is string && historyId.size() > 0
          && history.event_id == eventId
          && history.actor_id == request.auth.uid
          && history.action_type == 'VENUE_BOOKING_RELEASED'
          && history.created_at == request.time
          && booking.event_id == eventId && booking.status == 'RELEASED'
          && request.resource.data.updated_at == request.time
          && (approvedId == null
            || (approvedId is string
              && getAfter(/databases/$(database)/documents/venue_bookings/$(approvedId)).data.event_id == eventId
              && getAfter(/databases/$(database)/documents/venue_bookings/$(approvedId)).data.status == 'APPROVED'))
          && ((resource.data.status in ['CONFIRMED', 'SAFETY_REVIEW']
              && request.resource.data.status == 'PLANNING'
              && request.resource.data.get('last_safety_review_id', null) == null
              && request.resource.data.get('safety_review_required', false) == true)
            || (resource.data.status in ['APPROVED', 'PLANNING']
              && request.resource.data.status == resource.data.status))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'approved_venue_booking_id', 'last_safety_review_id',
            'safety_review_required', 'last_venue_release_id', 'updated_at'
          ]);
      }

      // F10 resolution reuses F11: after an explicit coordinator choice, their
      // approved booking is marked for replacement and a Confirmed event returns
      // to Planning. The linked history row and booking must be written in the
      // same commit, preventing an unrelated event status change from borrowing
      // an earlier replacement decision.
      function coordinatorClashReplacementUpdate() {
        let historyId = request.resource.data.get('last_venue_replacement_id', '');
        let history = getAfter(/databases/$(database)/documents/event_history/$(historyId)).data;
        let booking = getAfter(/databases/$(database)/documents/venue_bookings/$(history.booking_id)).data;
        return hasRole('EVENT_COORDINATOR')
          && resource.data.coordinator_id == request.auth.uid
          && resource.data.status in ['APPROVED', 'PLANNING', 'CONFIRMED']
          && historyId is string && historyId.size() > 0
          && history.event_id == eventId
          && history.actor_id == request.auth.uid
          && history.action_type == 'VENUE_REPLACEMENT_REQUESTED'
          && history.created_at == request.time
          && booking.event_id == eventId
          && booking.status == 'APPROVED'
          && booking.replacement_needed == true
          && booking.replacement_source == 'CLASH'
          && booking.replacement_requested_by == request.auth.uid
          && booking.replacement_requested_at == request.time
          && request.resource.data.get('safety_review_required', false) == true
          && request.resource.data.updated_at == request.time
          && ((resource.data.status == 'CONFIRMED'
              && request.resource.data.status == 'PLANNING'
              && request.resource.data.get('approved_venue_booking_id', null) == null
              && request.resource.data.get('last_safety_review_id', null) == null)
            || (resource.data.status in ['APPROVED', 'PLANNING']
              && request.resource.data.status == resource.data.status))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'approved_venue_booking_id', 'last_safety_review_id',
            'safety_review_required', 'last_venue_replacement_id', 'updated_at'
          ]);
      }

      allow create: if hasRole('EVENT_ORGANISER') && request.resource.data.organiser_id == request.auth.uid && request.resource.data.created_by == request.auth.uid && noClientCoordinatorWrite();
      allow get, list: if (hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid)
        || (hasRole('EVENT_COORDINATOR') && resource.data.get('coordinator_id', '') == request.auth.uid)
        // A6 — the Event Coordinator Lead oversees every event (AC3).
        || hasRole('EVENT_COORDINATOR_LEAD')
        || (hasRole('VENUE_STAFF') && resource.data.get('venue_staff_id', '') == request.auth.uid)
        || (hasRole('TECHNICAL_SUPPORT_STAFF') && resource.data.get('tech_support_id', '') == request.auth.uid)
        // A7 AC2 — a list query must filter on status == 'SAFETY_REVIEW'.
        || (hasRole('SAFETY_OFFICER') && resource.data.status == 'SAFETY_REVIEW');
      allow update: if (hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid && coordinatorUnchanged() && organiserMayEdit())
        || coordinatorWorkflowUpdate()
        || leadAssignmentUpdate()
        || coordinatorEventDetailsUpdate()
        || safetyOutcomeUpdate()
        || sendForSafetyCheckUpdate()
        || coordinatorSafetyNotesUpdate()
        || venueBookingApprovalLinkUpdate()
        || coordinatorVenueReleaseLinkUpdate()
        || coordinatorSingleVenueReleaseUpdate()
        || coordinatorClashReplacementUpdate();
      // B8 — only the owning organiser, and only while it is still a draft. Once a
      // request has been submitted it is part of a coordinator's queue, so it is
      // no longer the organiser's alone to remove.
      allow delete: if hasRole('EVENT_ORGANISER') && resource.data.organiser_id == request.auth.uid && resource.data.status == 'DRAFT';
    }

    // A7 AC3 — the Safety Officer reads the layout, accessibility and equipment
    // facts of an event under review, never writes them.
    match /event_venue_requirements/{requirementId} {
      allow create: if ownsEvent(request.resource.data.event_id) || significantChangeHistory(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
      allow update: if ownsEvent(resource.data.event_id) || significantChangeHistory(resource.data.event_id);
      allow delete: if ownsEvent(resource.data.event_id) || significantChangeHistory(resource.data.event_id);
    }
    match /event_facilities/{facilityId} {
      allow create: if ownsEvent(request.resource.data.event_id) || significantChangeHistory(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id);
      allow update: if ownsEvent(request.resource.data.event_id) || significantChangeHistory(request.resource.data.event_id);
      allow delete: if ownsEvent(resource.data.event_id) || significantChangeHistory(resource.data.event_id);
    }
    match /event_equipment/{equipmentId} {
      allow create: if ownsEvent(request.resource.data.event_id);
      allow get, list: if ownsEvent(resource.data.event_id)
        || currentCoordinator(resource.data.event_id)
        || safetyReviewing(resource.data.event_id);
      allow update, delete: if ownsEvent(resource.data.event_id);
    }
    match /event_accessibility/{accessibilityId} {
      allow create: if ownsEvent(request.resource.data.event_id) || significantChangeHistory(request.resource.data.event_id);
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
      allow update: if ownsEvent(request.resource.data.event_id) || significantChangeHistory(resource.data.event_id);
      allow delete: if ownsEvent(resource.data.event_id) || significantChangeHistory(resource.data.event_id);
    }
    match /event_history/{historyId} {
      allow create: if signedIn()
        && request.resource.data.get('history_id', historyId) == historyId
        && request.resource.data.actor_id == request.auth.uid
        && (ownsEvent(request.resource.data.event_id) || currentCoordinator(request.resource.data.event_id)
          // A7 AC4 — the Safety Officer records only the outcome they are making.
          || (safetyOutcomeCommit(request.resource.data.event_id)
            && request.resource.data.action_type in ['SAFETY_CHECK_APPROVED', 'SAFETY_CHECK_REJECTED', 'SAFETY_CHANGES_REQUESTED'])
          // A6 — the Lead records the (re)assignment it just made.
          || (hasRole('EVENT_COORDINATOR_LEAD')
            && request.resource.data.action_type in ['COORDINATOR_ASSIGNED', 'COORDINATOR_REASSIGNED'])
          || (request.resource.data.action_type == 'SIGNIFICANT_EVENT_DETAILS_CHANGED'
            && currentCoordinator(request.resource.data.event_id)
            && request.resource.data.warning_acknowledged == true
            && request.resource.data.created_at is timestamp
            && getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.last_significant_change_id == historyId)
          // F15 — the hold's row, by the staff member holding it, in the same commit.
          || (request.resource.data.action_type == 'VENUE_BOOKING_HELD'
            && request.resource.data.booking_id is string
            && request.resource.data.venue_id is string
            && assignedVenueStaff(request.resource.data.venue_id)
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.event_id == request.resource.data.event_id
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.status == 'HELD'
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.held_at == request.time)
          || (request.resource.data.action_type == 'VENUE_BOOKING_APPROVED'
            && request.resource.data.booking_id is string
            && request.resource.data.venue_id is string
            && assignedVenueStaff(request.resource.data.venue_id)
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.event_id == request.resource.data.event_id
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.status == 'APPROVED')
          || (request.resource.data.action_type == 'VENUE_BOOKING_REJECTED'
            && request.resource.data.booking_id is string
            && request.resource.data.venue_id is string
            && assignedVenueStaff(request.resource.data.venue_id)
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.status == 'REJECTED'
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.decided_at == request.time)
          // F11: Venue Staff approve the replacement and retain the original.
          || (request.resource.data.action_type == 'VENUE_REPLACED'
            && request.resource.data.booking_id is string
            && request.resource.data.new_booking_id is string
            && request.resource.data.venue_id is string
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.status == 'REPLACED'
            && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data.replaced_by_booking_id == request.resource.data.new_booking_id
            && assignedVenueStaff(getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.new_booking_id)).data.venue_id)));
      allow get, list: if canReadEvent(resource.data.event_id) || safetyReviewing(resource.data.event_id);
    }

    match /clarification_requests/{clarificationId} {
      allow get, list: if canReadEvent(resource.data.event_id);
      allow create: if hasRole('EVENT_COORDINATOR')
        && request.resource.data.clarification_id == clarificationId
        && request.resource.data.created_by == request.auth.uid
        && currentCoordinator(request.resource.data.event_id)
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.status == 'UNDER_REVIEW'
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('open_clarification_id', null) == null;
      allow update: if hasRole('EVENT_ORGANISER')
        && ownsEvent(resource.data.event_id)
        && resource.data.status == 'OPEN'
        && request.resource.data.status == 'ANSWERED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at']);
    }

    match /clarification_responses/{responseId} {
      function clarification() { return get(/databases/$(database)/documents/clarification_requests/$(request.resource.data.clarification_id)).data; }
      function existingClarification() { return get(/databases/$(database)/documents/clarification_requests/$(resource.data.clarification_id)).data; }
      allow get, list: if canReadEvent(existingClarification().event_id);
      allow create: if hasRole('EVENT_ORGANISER')
        && request.resource.data.response_id == responseId
        && request.resource.data.responder_id == request.auth.uid
        && ownsEvent(clarification().event_id)
        && clarification().status == 'OPEN';
    }

    // A7 AC4 / L3 — one record per check. Reject and Request changes need a
    // comment. No update or delete: a recorded outcome is history (L2 AC4 shows
    // earlier ones), and a fresh check after a return to Planning is a new record.
    match /safety_reviews/{reviewId} {
      // A7 AC6 — the Safety Officer reads an event's checks while it is under review.
      allow get, list: if safetyReviewing(resource.data.event_id) || canReadEvent(resource.data.event_id);
      // Decided now, and pointed at by the event after the same commit: a record
      // cannot be left lying about for a later check, nor backdated.
      allow create: if safetyReviewing(request.resource.data.event_id)
        && request.resource.data.review_id == reviewId
        && request.resource.data.reviewer_id == request.auth.uid
        && request.resource.data.outcome in ['APPROVE', 'REJECT', 'REQUEST_CHANGES']
        && (request.resource.data.outcome == 'APPROVE'
          || (request.resource.data.comment is string && request.resource.data.comment.size() > 0))
        && request.resource.data.decided_at == request.time
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('last_safety_review_id', '') == reviewId;
    }

    match /coordinator_assignments/{assignmentId} {
      allow get, list: if signedIn()
        && (resource.data.coordinator_id == request.auth.uid || canReadEvent(resource.data.event_id));
      allow create, update: if (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(request.resource.data.event_id)
          && assignmentId == request.resource.data.event_id + '_' + request.resource.data.coordinator_id)
        // A6 — the Lead writes the assignment record when it (re)assigns an event.
        // The id still has to match event_id + '_' + coordinator_id, so a record
        // can only name the coordinator it is actually for.
        || (hasRole('EVENT_COORDINATOR_LEAD')
          && assignmentId == request.resource.data.event_id + '_' + request.resource.data.coordinator_id);
    }

    match /notifications/{notificationId} {
      function eventCancellationRecord() {
        let event = getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data;
        let cancellation = getAfter(/databases/$(database)/documents/event_history/$(event.get('last_cancellation_id', ''))).data;
        return hasRole('EVENT_COORDINATOR')
          && event.status == 'CANCELLED'
          && event.coordinator_id == request.auth.uid
          && event.last_cancellation_id is string
          && cancellation.event_id == request.resource.data.event_id
          && cancellation.actor_id == request.auth.uid
          && cancellation.action_type == 'EVENT_CANCELLED'
          && cancellation.created_at == event.cancelled_at
          && request.resource.data.created_at == request.time;
      }
      function registeredAttendeeCancellationNotice() {
        let event = get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data;
        let registration = get(/databases/$(database)/documents/registrations/$(request.resource.data.get('registration_id', ''))).data;
        let cancellation = get(/databases/$(database)/documents/event_history/$(event.get('last_cancellation_id', ''))).data;
        return hasRole('EVENT_COORDINATOR')
          && event.status == 'CANCELLED'
          && event.coordinator_id == request.auth.uid
          && request.resource.data.type == 'EVENT_CANCELLED'
          && request.resource.data.registration_id is string
          && registration.event_id == request.resource.data.event_id
          && registration.status == 'REGISTERED'
          && (registration.user_id == request.resource.data.user_id
            || registration.attendee_id == request.resource.data.user_id)
          && cancellation.event_id == request.resource.data.event_id
          && cancellation.actor_id == request.auth.uid
          && cancellation.action_type == 'EVENT_CANCELLED'
          && cancellation.new_value == 'CANCELLED'
          && request.resource.data.created_at == request.time;
      }
      // J6 AC1 — a booking's outcome, told by the Venue Staff member deciding it
      // to the coordinator who raised it. `booking` is read after the write, and
      // both timestamps must be this request's, so the notice can only be written
      // in the same commit as the decision, never replayed afterwards.
      function venueBookingOutcomeNotice(booking) {
        return booking.event_id == request.resource.data.event_id
          && booking.venue_id == request.resource.data.venue_id
          && booking.requested_by == request.resource.data.user_id
          && booking.decided_by == request.auth.uid
          && booking.decided_at == request.time
          && request.resource.data.created_at == request.time
          && ((request.resource.data.type == 'VENUE_BOOKING_APPROVED' && booking.status == 'APPROVED')
            || (request.resource.data.type == 'VENUE_BOOKING_REJECTED' && booking.status == 'REJECTED'))
          && assignedVenueStaff(booking.venue_id);
      }
      // F15 AC6 — the coordinator who raised the request is told it is held, by
      // the staff member holding it and in the same commit as the hold.
      function venueBookingHoldNotice(booking) {
        return booking.event_id == request.resource.data.event_id
          && booking.venue_id == request.resource.data.venue_id
          && booking.requested_by == request.resource.data.user_id
          && booking.status == 'HELD'
          && booking.held_by == request.auth.uid && booking.held_at == request.time
          && request.resource.data.created_at == request.time
          && request.resource.data.type == 'VENUE_BOOKING_HELD'
          && assignedVenueStaff(booking.venue_id);
      }
      // J1 AC2 — a user reads only notifications addressed to them. AC3/AC4 — the
      // one change they may make is marking one read: it cannot be re-addressed,
      // reworded or marked unread, and with no delete rule it stays in the list.
      allow get, list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.is_read == true
        && request.resource.data.read_at is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'read_at']);
      // J6 AC3 — equipment outcomes are written only by the equipment service,
      // whose Admin SDK bypasses these rules, so no browser may create one. J6
      // AC1 — a venue booking outcome passes only the decider's clause, and no
      // other clause, so nobody else can send one.
      allow create: if signedIn()
        && request.resource.data.notification_id == notificationId
        && !(request.resource.data.get('type', '') in ['EQUIPMENT_ARRANGED', 'EQUIPMENT_UNABLE_TO_FULFIL'])
        // J5 AC1-AC4 — Technical Support's notices are written only by the equipment
        // service (Admin SDK), which these rules do not bind, so no browser may create one.
        && !(request.resource.data.get('type', '') in ['EQUIPMENT_REQUEST_RAISED', 'EQUIPMENT_REQUEST_AMENDED', 'ON_SITE_SUPPORT_REQUIRED', 'ON_SITE_SUPPORT_CHANGED'])
        // I3 AC2 AC5 — the notices that an arrangement must be requested again, and that a
        // registration needs review, are written only by the arrangements service (Admin
        // SDK), which these rules do not bind, so no browser may create one.
        && !(request.resource.data.get('type', '') in ['ARRANGEMENT_REREQUEST_REQUIRED', 'REGISTRATION_NEEDS_REVIEW'])
        && (
          (request.resource.data.get('type', '') in ['VENUE_BOOKING_APPROVED', 'VENUE_BOOKING_REJECTED']
            && request.resource.data.get('booking_id', null) is string
            && venueBookingOutcomeNotice(
              getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data))
          || (request.resource.data.get('type', '') == 'VENUE_BOOKING_HELD'
            && request.resource.data.get('booking_id', null) is string
            && venueBookingHoldNotice(
              getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.booking_id)).data))
          || (request.resource.data.get('type', '') == 'EVENT_CANCELLED'
            && eventCancellationRecord()
            && request.resource.data.user_id == getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organiser_id)
          || (request.resource.data.get('type', '') == 'EVENT_CANCELLED'
            && registeredAttendeeCancellationNotice())
          || (!(request.resource.data.get('type', '') in ['VENUE_BOOKING_APPROVED', 'VENUE_BOOKING_REJECTED', 'VENUE_BOOKING_HELD'])
            && request.resource.data.get('type', '') != 'EVENT_CANCELLED'
            && (
          (currentCoordinator(request.resource.data.event_id)
            && request.resource.data.user_id in [request.auth.uid,
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organiser_id,
              getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id])
          || (ownsEvent(request.resource.data.event_id)
            && request.resource.data.user_id == get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id)
          // L3 AC4 / L4 AC1 — the outcome goes to the event's coordinator and organiser.
          || (safetyOutcomeCommit(request.resource.data.event_id)
            && request.resource.data.type in ['SAFETY_CHECK_APPROVED', 'SAFETY_CHECK_REJECTED', 'SAFETY_CHANGES_REQUESTED']
            && request.resource.data.user_id in [
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organiser_id,
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id])
          // A6 — on (re)assignment the Lead notifies the new coordinator (the
          // event's coordinator after the write), the previous coordinator (before
          // the write) and the organiser. get() with a default keeps a freshly
          // assigned event, which had no coordinator_id, from erroring the clause.
          || (hasRole('EVENT_COORDINATOR_LEAD')
            && request.resource.data.user_id in [
              getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('coordinator_id', ''),
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('coordinator_id', ''),
              get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('organiser_id', '')])
          // J2 AC1 — submission received. A new request has no coordinator yet, so the
          // organiser records the notice in their own inbox: for their own event, one
          // type only, and only while that event is Submitted.
          || (safetyOutcomeCommit(request.resource.data.event_id)
            && request.resource.data.type == 'ARRANGEMENT_REVIEW_REQUIRED'
            && request.resource.data.created_at == request.time)
          || (hasRole('EVENT_COORDINATOR')
            && request.resource.data.type == 'SAFETY_REVIEW_WAITING'
            && getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.status == 'SAFETY_REVIEW'
            && getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id == request.auth.uid
            && getAfter(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.safety_review_requested_at == request.time
            && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'SAFETY_OFFICER'
            && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.is_active == true
            && request.resource.data.created_at == request.time)
          || (hasRole('EVENT_COORDINATOR')
            && currentCoordinator(request.resource.data.event_id)
            && request.resource.data.type in ['DATE', 'TIME', 'VENUE']
            && request.resource.data.registration_id is string
            && request.resource.data.created_at == request.time
            && get(/databases/$(database)/documents/registrations/$(request.resource.data.registration_id)).data.event_id == request.resource.data.event_id
            && get(/databases/$(database)/documents/registrations/$(request.resource.data.registration_id)).data.status == 'REGISTERED'
            && (get(/databases/$(database)/documents/registrations/$(request.resource.data.registration_id)).data.attendee_id == request.resource.data.user_id
              || get(/databases/$(database)/documents/registrations/$(request.resource.data.registration_id)).data.user_id == request.resource.data.user_id))
          || (ownsEvent(request.resource.data.event_id)
            && request.resource.data.type == 'EVENT_SUBMITTED'
            && request.resource.data.user_id == request.auth.uid
            && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.status == 'SUBMITTED')
          // Venue Staff are notified for the venue they manage when a booking
          // request opens or the venue details change for a related event.
          || (request.resource.data.get('venue_id', null) is string
            && exists(/databases/$(database)/documents/venue_staff/$(request.resource.data.venue_id))
            && get(/databases/$(database)/documents/venue_staff/$(request.resource.data.venue_id)).data.user_id == request.resource.data.user_id)
        )));
    }

    // E2 / E5 — catalogue and search reads are Coordinator and Venue Staff only.
    // Hiding the screen is not the boundary (A4 / TC-015). A7 AC3 / E10 AC3 add
    // the Safety Officer, read-only, to venues, layouts and accessibility for
    // capacity, layout, emergency access and known restrictions.
    match /venue_staff/{venueId} {
      allow get, list: if hasRole('VENUE_STAFF')
        && resource.data.user_id == request.auth.uid;
      // J4 — a coordinator raising a booking reads the one venue's assignment to
      // address its "booking request raised" notice. A single get, never a list,
      // so no coordinator can enumerate who manages every venue.
      allow get: if hasRole('EVENT_COORDINATOR');
    }
    match /venues/{venueId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
      allow update: if assignedVenueStaff(venueId)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'building', 'location', 'max_capacity', 'layouts', 'facilities',
            'accessibility', 'operating_hours', 'special_space_availability'
          ])
          && request.resource.data.name is string
          && request.resource.data.building is string
          && request.resource.data.location is string
          && request.resource.data.max_capacity is int
          && request.resource.data.max_capacity > 0
          && request.resource.data.layouts is list
          && request.resource.data.layouts.size() > 0
          && request.resource.data.facilities is list
          && request.resource.data.accessibility is list
          && request.resource.data.operating_hours is list
          && request.resource.data.special_space_availability is string)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'setup_minutes', 'turnaround_minutes', 'emergency_access_notes', 'known_restrictions'
          ])
          && request.resource.data.setup_minutes is int
          && request.resource.data.setup_minutes >= 0
          && request.resource.data.turnaround_minutes is int
          && request.resource.data.turnaround_minutes >= 0
          && request.resource.data.emergency_access_notes is string
          && request.resource.data.known_restrictions is string)
        );
    }
    match /venue_change_history/{historyId} {
      allow create: if request.resource.data.history_id == historyId
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.venue_id is string
        && request.resource.data.field_name in [
          'setup_minutes', 'turnaround_minutes', 'emergency_access_notes', 'known_restrictions'
        ]
        && request.resource.data.created_at is timestamp
        && assignedVenueStaff(request.resource.data.venue_id);
      allow get, list: if assignedVenueStaff(resource.data.venue_id);
    }
    match /venue_layouts/{layoutId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
    }
    match /venue_facilities/{facilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_accessibility/{accessibilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF') || hasRole('SAFETY_OFFICER');
    }
    match /venue_operating_hours/{hoursId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_unavailability/{unavailabilityId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || hasRole('VENUE_STAFF');
    }
    match /venue_bookings/{bookingId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') || assignedVenueStaff(resource.data.venue_id)
        || (hasRole('TECHNICAL_SUPPORT_STAFF') && resource.data.status == 'APPROVED')
        || safetyReviewing(resource.data.event_id);
      // E8 — the suitability gate, enforced where it cannot be bypassed. A screen
      // that merely disables its button does not stop a crafted request, so the
      // capacity stop is re-checked against the venue record here, and a booking
      // is refused unless it carries the acknowledgement Venue Staff will read.
      allow create: if hasRole('EVENT_COORDINATOR')
        && request.resource.data.requested_by == request.auth.uid
        && exists(/databases/$(database)/documents/events/$(request.resource.data.event_id))
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.coordinator_id == request.auth.uid
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.status in ['APPROVED', 'PLANNING']
        && request.resource.data.status == 'PENDING'
        && request.resource.data.venue_id is string
        && request.resource.data.event_id is string
        && request.resource.data.expected_attendance is int
        && request.resource.data.expected_attendance > 0
        // F12 AC2/AC3 — each of an event's bookings is labelled, and none may
        // expect more people than the event itself.
        && request.resource.data.expected_attendance <= get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.expected_attendance
        && request.resource.data.booking_label is string
        && request.resource.data.booking_label.trim().size() > 0
        && request.resource.data.layout_snapshot is string
        && request.resource.data.layout_snapshot.size() > 0
        && request.resource.data.required_facilities_snapshot is list
        && exists(/databases/$(database)/documents/venues/$(request.resource.data.venue_id))
        && get(/databases/$(database)/documents/venues/$(request.resource.data.venue_id)).data.max_capacity >= request.resource.data.expected_attendance
        && request.resource.data.suitability_acknowledgement.acknowledged is bool
        && request.resource.data.suitability_acknowledgement.criteria is list;
      allow update: if
        // K5 / SCRUM-186 AC2 — withdrawing is for the coordinator the event is assigned to
        // now. The request may have been raised by the previous coordinator.
        (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(resource.data.event_id)
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'WITHDRAWN'
          && request.resource.data.suitability_acknowledgement == resource.data.suitability_acknowledgement
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawn_at']))
        // F15 AC1/AC2 — the venue's own staff hold a pending request, stamped now,
        // for exactly three working days, ending before the venue is first needed.
        || (assignedVenueStaff(resource.data.venue_id)
          && resource.data.status == 'PENDING' && request.resource.data.status == 'HELD'
          && request.resource.data.assigned_staff_id == request.auth.uid
          && request.resource.data.held_by == request.auth.uid
          && request.resource.data.held_at == request.time
          && holdExpiryIsThreeWorkingDays(request.resource.data.hold_expires_at)
          && request.resource.data.occupied_start is timestamp
          && request.resource.data.occupied_end is timestamp
          && request.resource.data.hold_expires_at < request.resource.data.occupied_start
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assigned_staff_id', 'held_by', 'held_at', 'hold_expires_at', 'occupied_start', 'occupied_end'
          ]))
        // F4 — approve a pending request, or (F15 AC7) convert a hold that has not expired.
        || (assignedVenueStaff(resource.data.venue_id)
          && (resource.data.status == 'PENDING' || (resource.data.status == 'HELD' && resource.data.hold_expires_at > request.time))
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.assigned_staff_id == request.auth.uid
          && request.resource.data.decided_by == request.auth.uid
          && request.resource.data.decided_at is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assigned_staff_id', 'decided_by', 'decided_at', 'occupied_start', 'occupied_end'
          ]))
        || (assignedVenueStaff(resource.data.venue_id)
          && resource.data.status in ['PENDING', 'HELD']
          && request.resource.data.status == 'REJECTED'
          && request.resource.data.assigned_staff_id == request.auth.uid
          && request.resource.data.decided_by == request.auth.uid
          && request.resource.data.decided_at == request.time
          && request.resource.data.decision_reason is string
          && request.resource.data.decision_reason.trim().size() > 0
          && request.resource.data.requires_re_request == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'decision_reason', 'decided_by', 'decided_at', 'assigned_staff_id', 'requires_re_request'
          ]))
        // F11: approving a replacement retires, but does not delete, the
        // unavailable original booking in the same transaction.
        || (assignedVenueStaff(getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replaced_by_booking_id)).data.venue_id)
          && resource.data.status == 'APPROVED'
          && resource.data.replacement_needed == true
          && request.resource.data.status == 'REPLACED'
          && request.resource.data.replacement_needed == false
          && request.resource.data.replaced_by_booking_id is string
          && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replaced_by_booking_id)).data.status == 'APPROVED'
          && getAfter(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replaced_by_booking_id)).data.get('replacement_for_booking_id', '') == bookingId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'replacement_needed', 'replaced_by_booking_id', 'replaced_at', 'released_at', 'release_reason'
          ]))
        || (assignedVenueStaff(resource.data.venue_id)
          && resource.data.status == 'APPROVED'
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.occupied_start is timestamp
          && request.resource.data.occupied_end is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupied_start', 'occupied_end']))
        // F10 resolution: detection itself changes nothing. The current
        // coordinator may explicitly choose to replace only their own approved
        // booking, with the event/history linkage validated above.
        || (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(resource.data.event_id)
          && resource.data.status == 'APPROVED'
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.replacement_needed == true
          && request.resource.data.replacement_status == 'Schedule clash - replacement needed'
          && request.resource.data.replacement_source == 'CLASH'
          && request.resource.data.replacement_reason is string
          && request.resource.data.replacement_reason.trim().size() > 0
          && request.resource.data.replacement_conflict_id is string
          && request.resource.data.replacement_conflict_id.size() > 0
          && request.resource.data.replacement_conflicting_booking_id is string
          && request.resource.data.replacement_conflicting_booking_id != bookingId
          && get(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replacement_conflicting_booking_id)).data.status == 'APPROVED'
          && get(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replacement_conflicting_booking_id)).data.venue_id == resource.data.venue_id
          && resource.data.occupied_start < get(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replacement_conflicting_booking_id)).data.occupied_end
          && get(/databases/$(database)/documents/venue_bookings/$(request.resource.data.replacement_conflicting_booking_id)).data.occupied_start < resource.data.occupied_end
          && request.resource.data.replacement_requested_by == request.auth.uid
          && request.resource.data.replacement_requested_at == request.time
          && request.resource.data.safety_review_required == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'replacement_needed', 'replacement_status', 'replacement_reason',
            'replacement_requested_at', 'replacement_requested_by',
            'replacement_source', 'replacement_conflict_id',
            'replacement_conflicting_booking_id', 'safety_review_required'
          ]))
        // F14: the current coordinator releases exactly one approved booking,
        // with a reason and a same-commit history row referenced by the event.
        || (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(resource.data.event_id)
          && resource.data.status == 'APPROVED'
          && request.resource.data.status == 'RELEASED'
          && request.resource.data.release_reason is string
          && request.resource.data.release_reason.trim().size() > 0
          && request.resource.data.released_at == request.time
          && request.resource.data.safety_review_required == true
          && getAfter(/databases/$(database)/documents/events/$(resource.data.event_id)).data.last_venue_release_id is string
          && getAfter(/databases/$(database)/documents/event_history/$(getAfter(/databases/$(database)/documents/events/$(resource.data.event_id)).data.last_venue_release_id)).data.booking_id == bookingId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'released_at', 'release_reason', 'safety_review_required'
          ]))
        || (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(resource.data.event_id)
          && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.status == 'CANCELLED'
          && ((resource.data.status == 'APPROVED' && request.resource.data.status == 'RELEASED')
            || (resource.data.status in ['PENDING', 'HELD'] && request.resource.data.status == 'WITHDRAWN'))
          && request.resource.data.released_at is timestamp
          && request.resource.data.release_reason is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'released_at', 'release_reason']))
        // L4 / SCRUM-190 — a safety concern flags the booking for review, and the
        // assigned coordinator clears that flag once the booking is acceptable again.
        || (safetyOutcomeCommit(resource.data.event_id)
          && request.resource.data.review_status == 'Review required'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status']))
        || (hasRole('EVENT_COORDINATOR')
          && currentCoordinator(resource.data.event_id)
          && request.resource.data.review_status == 'Reviewed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status']));
    }
    match /venue_booking_conflicts/{conflictId} {
      // F10's trusted backend owns persisted detection and notification. Venue
      // Staff see only their venues; current coordinators may read conflicts
      // involving their assigned event and resolve a persisted row after acting.
      allow get, list: if assignedVenueStaff(resource.data.venue_id)
        || currentCoordinator(resource.data.event_a_id)
        || currentCoordinator(resource.data.event_b_id);
      allow update: if hasRole('EVENT_COORDINATOR')
        && (currentCoordinator(resource.data.event_a_id) || currentCoordinator(resource.data.event_b_id))
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'RESOLVED'
        && request.resource.data.resolved_at is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolved_at']);
    }
    // D2 limits coordinator reads to related events. G3 reservation writes go
    // through the authenticated equipment service, not the browser SDK.
    match /equipment_reservations/{reservationId} {
      // A7 AC3 — the Safety Officer sees what is reserved, while the event is under review.
      allow get, list: if (hasRole('EVENT_COORDINATOR') && currentCoordinator(resource.data.event_id))
        || hasRole('TECHNICAL_SUPPORT_STAFF')
        || safetyReviewing(resource.data.event_id);
    }
    // The Admin-backed G3 equipment service owns inventory revisions and
    // reservations. The browser can read availability, but cannot write stock.
    match /equipment_inventory/{equipmentType} {
      allow get, list: if hasRole('TECHNICAL_SUPPORT_STAFF');
    }
    match /equipment_unavailability/{unavailabilityId} {
      allow get, list: if hasRole('TECHNICAL_SUPPORT_STAFF');
    }
    match /equipment_requests/{eventId} {
      allow get: if hasRole('EVENT_COORDINATOR') && currentCoordinator(eventId);
      allow list: if (hasRole('EVENT_COORDINATOR') && currentCoordinator(resource.data.event_id))
        || (hasRole('TECHNICAL_SUPPORT_STAFF') && resource.data.status == 'PENDING');
      allow create: if hasRole('EVENT_COORDINATOR')
        && currentCoordinator(eventId)
        && request.resource.data.request_id == eventId
        && request.resource.data.event_id == eventId
        && request.resource.data.coordinator_id == request.auth.uid
        && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in [
          'COMPLETED', 'CANCELLED', 'REJECTED'
        ])
        && request.resource.data.status == 'PENDING'
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.submitted_at is timestamp
        && request.resource.data.updated_at is timestamp;
      allow update: if hasRole('EVENT_COORDINATOR')
        && currentCoordinator(eventId)
        && resource.data.status == 'PENDING'
        && resource.data.get('has_support_decisions', false) == false
        && resource.data.event_id == eventId
        && request.resource.data.request_id == resource.data.request_id
        && request.resource.data.event_id == resource.data.event_id
        && request.resource.data.coordinator_id == request.auth.uid
        && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in [
          'COMPLETED', 'CANCELLED', 'REJECTED'
        ])
        && request.resource.data.status == 'PENDING'
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.submitted_at == resource.data.submitted_at
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'event_name', 'reference_no', 'event_date', 'start_time', 'end_time',
          'expected_attendance', 'coordinator_id', 'lines', 'on_site_support',
          'on_site_support_details', 'updated_at'
        ]);
    }
    match /equipment_request_history/{historyId} {
      allow get, list: if hasRole('EVENT_COORDINATOR')
        && currentCoordinator(resource.data.event_id);
    }
    match /registrations/{registrationId} {
      allow get, list: if hasRole('EVENT_COORDINATOR') && currentCoordinator(resource.data.event_id);
      // H3 / SCRUM-141 — no browser creates, changes or removes a registration. Attendees
      // register through the registration service, which checks the open window (H1 AC4) by
      // the server's clock, counts the places left and refuses a duplicate in one transaction:
      // things a rule cannot do, since it cannot count documents.
    }
  }
}

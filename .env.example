# Copy to `.env` in this same folder and fill in the values — ask the team for them.
# One file serves both workspaces: the root npm scripts load it with dotenv-cli
# before handing off to the workspace, so always run from the repo root.
#
# `.env` is gitignored. This example is committed and must stay empty of values.

# --- frontend (Firebase Web SDK) -------------------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# CRA inlines every REACT_APP_* var into the client bundle, so treat these as
# public — they are not secrets, and access is enforced by firestore.rules.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# --- backend ----------------------------------------------------------------
# Both optional; the defaults below are what the code falls back to.
# Not PORT — CRA reads PORT for the dev server and would collide.
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

{
  "name": "connectsphere-spm-g6t1",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectSphere — Event Planning and Venue Booking System. IS212 G6 T1.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm:start:backend\" \"npm:start:frontend\"",
    "start:frontend": "npm start --workspace frontend",
    "start:backend": "npm start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}

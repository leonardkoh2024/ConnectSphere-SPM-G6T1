{
  "name": "connectsphere-spm-g6t1",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectSphere — Event Planning and Venue Booking System. IS212 G6 T1.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm:start:backend\" \"npm:start:frontend\"",
    "start:frontend": "dotenv -e .env -- npm start --workspace frontend",
    "start:backend": "dotenv -e .env -- npm start --workspace backend",
    "build": "dotenv -e .env -- npm run build --workspace frontend",
    "test": "dotenv -e .env -- npm test --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test:backend": "dotenv -e .env -- npm test --workspace backend",
    "test:integration": "firebase emulators:exec --only firestore --project demo-connectsphere \"npm run test:integration --workspace backend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "dotenv-cli": "^11.0.0",
    "firebase-tools": "^15.31.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  }
}
